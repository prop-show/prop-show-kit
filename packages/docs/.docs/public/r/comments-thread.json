{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "comments-thread",
  "title": "Comments Thread",
  "description": "A threaded discussion with replies nested under each comment.",
  "dependencies": ["@lucide/vue"],
  "registryDependencies": ["avatar", "button", "textarea"],
  "files": [
    {
      "path": "registry/comments-thread/CommentsThread.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\";\nimport { MessageSquareIcon } from \"@lucide/vue\";\nimport { computed, nextTick, shallowRef, useId } from \"vue\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { cn } from \"@/lib/utils\";\nimport CommentBranch from \"./CommentBranch.vue\";\nimport CommentComposer from \"./CommentComposer.vue\";\nimport {\n  addComment,\n  commentInitials,\n  countComments,\n  createComment,\n  DEFAULT_MAX_DEPTH,\n} from \"./thread\";\nimport type { CommentAuthor, CommentItem } from \"./thread\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst props = withDefaults(\n  defineProps<{\n    author: CommentAuthor;\n    title?: string;\n    replyLabel?: string;\n    cancelLabel?: string;\n    commentLabel?: string;\n    replySubmitLabel?: string;\n    placeholder?: string;\n    replyPlaceholder?: string;\n    replyToLabel?: string;\n    emptyTitle?: string;\n    emptyDescription?: string;\n    maxDepth?: number;\n    createId?: () => string;\n    class?: HTMLAttributes[\"class\"];\n  }>(),\n  {\n    title: \"Comments\",\n    replyLabel: \"Reply\",\n    cancelLabel: \"Cancel\",\n    commentLabel: \"Comment\",\n    replySubmitLabel: \"Reply\",\n    placeholder: \"Write a comment\",\n    replyPlaceholder: \"Write a reply\",\n    replyToLabel: \"Reply to {name}\",\n    emptyTitle: \"No comments yet\",\n    emptyDescription: \"Start the thread with the first comment.\",\n    maxDepth: DEFAULT_MAX_DEPTH,\n    createId: () => {\n      const crypto = globalThis.crypto;\n      if (crypto?.randomUUID) return crypto.randomUUID();\n      return `comment-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;\n    },\n  },\n);\n\nconst items = defineModel<CommentItem[]>({ default: () => [] });\nconst draft = defineModel<string>(\"draft\", { default: \"\" });\n\nconst emit = defineEmits<{\n  submit: [comment: CommentItem, parentId: string | null];\n}>();\n\nconst titleId = useId();\nconst replyingTo = shallowRef<string | null>(null);\nconst status = shallowRef(\"\");\nconst source = computed(() => (Array.isArray(items.value) ? items.value : []));\nconst count = computed(() => countComments(source.value));\nconst countLabel = computed(() => (count.value === 1 ? \"1 comment\" : `${count.value} comments`));\n\nfunction post(parentId: string | null, body: string) {\n  const comment = createComment({\n    id: props.createId(),\n    author: props.author,\n    body,\n    createdAt: new Date(),\n  });\n  if (!comment) return false;\n  const next = addComment(source.value, comment, parentId, props.maxDepth);\n  if (next === source.value) return false;\n  items.value = next.slice();\n  status.value = \"\";\n  const message = parentId ? \"Reply posted.\" : \"Comment posted.\";\n  void nextTick(() => {\n    status.value = message;\n  });\n  emit(\"submit\", comment, parentId);\n  return true;\n}\n\nfunction postRoot(body: string) {\n  if (post(null, body)) draft.value = \"\";\n}\n\nfunction postReply(id: string, body: string) {\n  if (post(id, body)) replyingTo.value = null;\n}\n\nfunction requestReply(id: string) {\n  replyingTo.value = replyingTo.value === id ? null : id;\n}\n</script>\n\n<template>\n  <section\n    v-bind=\"$attrs\"\n    data-slot=\"comments-thread\"\n    :aria-labelledby=\"titleId\"\n    :class=\"\n      cn(\n        'flex w-full min-w-0 flex-col gap-4 rounded-xl border bg-background p-4 text-foreground shadow-sm',\n        props.class,\n      )\n    \"\n  >\n    <header data-slot=\"comments-thread-header\" class=\"flex items-baseline gap-2\">\n      <h2 :id=\"titleId\" class=\"text-sm font-semibold\">{{ title }}</h2>\n      <span v-if=\"count > 0\" class=\"text-sm text-muted-foreground\" aria-hidden=\"true\">{{\n        count\n      }}</span>\n      <span class=\"sr-only\">{{ countLabel }}</span>\n    </header>\n\n    <ul\n      v-if=\"source.length\"\n      data-slot=\"comments-thread-list\"\n      role=\"list\"\n      class=\"m-0 flex list-none flex-col gap-4 p-0\"\n    >\n      <CommentBranch\n        v-for=\"comment in source\"\n        :key=\"comment.id\"\n        :comment=\"comment\"\n        :depth=\"1\"\n        :max-depth=\"maxDepth\"\n        :replying-to=\"replyingTo\"\n        :reply-label=\"replyLabel\"\n        :cancel-label=\"cancelLabel\"\n        :reply-submit-label=\"replySubmitLabel\"\n        :reply-placeholder=\"replyPlaceholder\"\n        :reply-to-label=\"replyToLabel\"\n        @reply=\"requestReply\"\n        @cancel=\"replyingTo = null\"\n        @submit=\"postReply\"\n      >\n        <template v-if=\"$slots.comment\" #comment=\"slotProps\">\n          <slot name=\"comment\" v-bind=\"slotProps\" />\n        </template>\n      </CommentBranch>\n    </ul>\n    <div\n      v-else\n      data-slot=\"comments-thread-empty\"\n      class=\"flex flex-col items-center gap-2 px-6 py-8 text-center\"\n    >\n      <slot name=\"empty\">\n        <MessageSquareIcon class=\"size-8 text-muted-foreground\" aria-hidden=\"true\" />\n        <p class=\"text-sm font-medium\">{{ emptyTitle }}</p>\n        <p class=\"max-w-xs text-sm text-muted-foreground\">{{ emptyDescription }}</p>\n      </slot>\n    </div>\n\n    <div class=\"flex gap-3 border-t pt-4\">\n      <Avatar class=\"mt-0.5 size-8\" aria-hidden=\"true\">\n        <AvatarImage v-if=\"author.avatarUrl\" :src=\"author.avatarUrl\" alt=\"\" />\n        <AvatarFallback>{{ commentInitials(author.name) }}</AvatarFallback>\n      </Avatar>\n      <CommentComposer\n        v-model=\"draft\"\n        class=\"min-w-0 flex-1\"\n        :label=\"placeholder\"\n        :placeholder=\"placeholder\"\n        :submit-label=\"commentLabel\"\n        :disabled=\"!author.name.trim()\"\n        @submit=\"postRoot\"\n      />\n    </div>\n    <p class=\"sr-only\" aria-live=\"polite\">{{ status }}</p>\n  </section>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/comments-thread/CommentBranch.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, useId } from \"vue\";\nimport { ReplyIcon } from \"@lucide/vue\";\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\nimport { Button } from \"@/components/ui/button\";\nimport CommentComposer from \"./CommentComposer.vue\";\nimport {\n  canReply,\n  commentDateTime,\n  commentInitials,\n  commentReplies,\n  formatCommentTime,\n} from \"./thread\";\nimport type { CommentItem } from \"./thread\";\n\ndefineOptions({ name: \"CommentBranch\" });\n\nconst props = defineProps<{\n  comment: CommentItem;\n  depth: number;\n  maxDepth: number;\n  replyingTo: string | null;\n  replyLabel: string;\n  cancelLabel: string;\n  replySubmitLabel: string;\n  replyPlaceholder: string;\n  replyToLabel: string;\n}>();\n\nconst emit = defineEmits<{\n  reply: [id: string];\n  cancel: [];\n  submit: [id: string, body: string];\n}>();\n\nconst nameId = useId();\nconst composerId = useId();\nconst replies = computed(() => commentReplies(props.comment));\nconst open = computed(() => props.replyingTo === props.comment.id);\nconst allowReply = computed(() => canReply(props.depth, props.maxDepth));\nconst replyName = computed(() =>\n  props.replyToLabel.replaceAll(\"{name}\", props.comment.author.name),\n);\nconst when = computed(() => formatCommentTime(props.comment.createdAt));\nconst datetime = computed(() => commentDateTime(props.comment.createdAt));\n\nfunction forwardSubmit(id: string, body: string) {\n  emit(\"submit\", id, body);\n}\n</script>\n\n<template>\n  <li data-slot=\"comments-thread-comment\" :data-comment-id=\"comment.id\" :data-depth=\"depth\">\n    <div class=\"flex gap-3\">\n      <Avatar class=\"mt-0.5 size-8\" aria-hidden=\"true\">\n        <AvatarImage v-if=\"comment.author.avatarUrl\" :src=\"comment.author.avatarUrl\" alt=\"\" />\n        <AvatarFallback>{{ commentInitials(comment.author.name) }}</AvatarFallback>\n      </Avatar>\n      <div class=\"min-w-0 flex-1\">\n        <article :aria-labelledby=\"nameId\">\n          <div class=\"flex flex-wrap items-baseline gap-x-2 gap-y-0.5\">\n            <span :id=\"nameId\" class=\"text-sm font-medium\">{{ comment.author.name }}</span>\n            <time v-if=\"datetime\" :datetime=\"datetime\" class=\"text-xs text-muted-foreground\">{{\n              when\n            }}</time>\n          </div>\n          <div class=\"mt-1 text-sm\">\n            <slot name=\"comment\" :comment=\"comment\">\n              <p class=\"whitespace-pre-wrap\">{{ comment.body }}</p>\n            </slot>\n          </div>\n          <div v-if=\"allowReply\" class=\"mt-1\">\n            <Button\n              type=\"button\"\n              variant=\"ghost\"\n              size=\"xs\"\n              :aria-expanded=\"open\"\n              :aria-controls=\"open ? composerId : undefined\"\n              @click=\"emit('reply', comment.id)\"\n            >\n              <ReplyIcon aria-hidden=\"true\" />\n              {{ replyLabel }}\n              <span class=\"sr-only\"> to {{ comment.author.name }}</span>\n            </Button>\n          </div>\n          <CommentComposer\n            v-if=\"open\"\n            :form-id=\"composerId\"\n            class=\"mt-2\"\n            :label=\"replyName\"\n            :placeholder=\"replyPlaceholder\"\n            :submit-label=\"replySubmitLabel\"\n            :cancel-label=\"cancelLabel\"\n            show-cancel\n            autofocus\n            @submit=\"emit('submit', comment.id, $event)\"\n            @cancel=\"emit('cancel')\"\n          />\n        </article>\n        <ul\n          v-if=\"replies.length\"\n          data-slot=\"comments-thread-replies\"\n          role=\"list\"\n          class=\"m-0 mt-3 list-none space-y-3 border-l pl-3\"\n        >\n          <CommentBranch\n            v-for=\"reply in replies\"\n            :key=\"reply.id\"\n            :comment=\"reply\"\n            :depth=\"depth + 1\"\n            :max-depth=\"maxDepth\"\n            :replying-to=\"replyingTo\"\n            :reply-label=\"replyLabel\"\n            :cancel-label=\"cancelLabel\"\n            :reply-submit-label=\"replySubmitLabel\"\n            :reply-placeholder=\"replyPlaceholder\"\n            :reply-to-label=\"replyToLabel\"\n            @reply=\"emit('reply', $event)\"\n            @cancel=\"emit('cancel')\"\n            @submit=\"forwardSubmit\"\n          >\n            <template v-if=\"$slots.comment\" #comment=\"slotProps\">\n              <slot name=\"comment\" v-bind=\"slotProps\" />\n            </template>\n          </CommentBranch>\n        </ul>\n      </div>\n    </div>\n  </li>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/comments-thread/CommentComposer.vue",
      "content": "<script setup lang=\"ts\">\nimport { useId } from \"vue\";\nimport { Button } from \"@/components/ui/button\";\nimport { Textarea } from \"@/components/ui/textarea\";\n\nconst draft = defineModel<string>({ default: \"\" });\n\nconst props = withDefaults(\n  defineProps<{\n    label: string;\n    placeholder?: string;\n    submitLabel: string;\n    cancelLabel?: string;\n    showCancel?: boolean;\n    autofocus?: boolean;\n    disabled?: boolean;\n    formId?: string;\n  }>(),\n  {\n    placeholder: \"\",\n    cancelLabel: \"Cancel\",\n    showCancel: false,\n    autofocus: false,\n    disabled: false,\n  },\n);\n\nconst emit = defineEmits<{\n  submit: [body: string];\n  cancel: [];\n}>();\n\nconst fieldId = useId();\n\nfunction submit() {\n  const body = draft.value.trim();\n  if (!body || props.disabled) return;\n  emit(\"submit\", body);\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  if (event.key === \"Escape\" && props.showCancel) {\n    event.preventDefault();\n    emit(\"cancel\");\n    return;\n  }\n  if (event.key === \"Enter\" && (event.metaKey || event.ctrlKey)) {\n    event.preventDefault();\n    submit();\n  }\n}\n</script>\n\n<template>\n  <form\n    :id=\"formId\"\n    data-slot=\"comments-thread-composer\"\n    class=\"flex flex-col gap-2\"\n    @submit.prevent=\"submit\"\n  >\n    <label class=\"text-sm font-medium\" :class=\"showCancel ? '' : 'sr-only'\" :for=\"fieldId\">\n      {{ label }}\n    </label>\n    <Textarea\n      :id=\"fieldId\"\n      v-model=\"draft\"\n      :placeholder=\"placeholder\"\n      :disabled=\"disabled\"\n      :autofocus=\"autofocus\"\n      class=\"min-h-16\"\n      @keydown=\"onKeydown\"\n    />\n    <div class=\"flex justify-end gap-2\">\n      <Button v-if=\"showCancel\" type=\"button\" variant=\"ghost\" size=\"sm\" @click=\"emit('cancel')\">\n        {{ cancelLabel }}\n      </Button>\n      <Button type=\"submit\" size=\"sm\" :disabled=\"disabled || !draft.trim()\">\n        {{ submitLabel }}\n      </Button>\n    </div>\n  </form>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/comments-thread/thread.ts",
      "content": "export interface CommentAuthor {\n  name: string;\n  /** Optional image URL. When omitted, the avatar shows initials from the name. */\n  avatarUrl?: string;\n}\n\nexport interface CommentItem {\n  id: string;\n  author: CommentAuthor;\n  body: string;\n  createdAt: string | number | Date;\n  replies?: CommentItem[];\n}\n\n/** Deepest comment that can exist. A top-level comment is depth 1. */\nexport const DEFAULT_MAX_DEPTH = 3;\n\nconst MINUTE = 60_000;\nconst HOUR = 60 * MINUTE;\nconst DAY = 24 * HOUR;\n\nexport function normalizeMaxDepth(maxDepth: number): number {\n  return Number.isInteger(maxDepth) && maxDepth >= 1 ? maxDepth : 1;\n}\n\nexport function commentReplies(item: CommentItem): readonly CommentItem[] {\n  return Array.isArray(item.replies) ? item.replies : [];\n}\n\nexport function commentTimeValue(value: CommentItem[\"createdAt\"]): number | null {\n  const time =\n    value instanceof Date ? value.getTime() : typeof value === \"number\" ? value : Date.parse(value);\n  return Number.isFinite(time) ? time : null;\n}\n\n/** English relative label. Dates older than a week use a UTC `YYYY-MM-DD` day. */\nexport function formatCommentTime(value: CommentItem[\"createdAt\"], now = Date.now()): string {\n  const time = commentTimeValue(value);\n  if (time === null) return \"\";\n  const delta = Math.max(0, now - time);\n  if (delta < MINUTE) return \"Just now\";\n  if (delta < HOUR) {\n    const minutes = Math.floor(delta / MINUTE);\n    return minutes === 1 ? \"1 minute ago\" : `${minutes} minutes ago`;\n  }\n  if (delta < DAY) {\n    const hours = Math.floor(delta / HOUR);\n    return hours === 1 ? \"1 hour ago\" : `${hours} hours ago`;\n  }\n  const days = Math.floor(delta / DAY);\n  if (days < 7) return days === 1 ? \"1 day ago\" : `${days} days ago`;\n  return new Date(time).toISOString().slice(0, 10);\n}\n\nexport function commentDateTime(value: CommentItem[\"createdAt\"]): string | undefined {\n  const time = commentTimeValue(value);\n  return time === null ? undefined : new Date(time).toISOString();\n}\n\nexport function commentInitials(name: string): string {\n  const parts = name.trim().split(/\\s+/).filter(Boolean);\n  const first = parts[0];\n  if (!first) return \"?\";\n  const start = first.codePointAt(0);\n  const end = parts.length > 1 ? parts[parts.length - 1]?.codePointAt(0) : undefined;\n  const startChar = start === undefined ? \"?\" : String.fromCodePoint(start);\n  const endChar = end === undefined ? \"\" : String.fromCodePoint(end);\n  return `${startChar}${endChar}`.toUpperCase();\n}\n\nexport function countComments(items: readonly CommentItem[]): number {\n  let count = 0;\n  for (const item of items) count += 1 + countComments(commentReplies(item));\n  return count;\n}\n\nexport function findComment(items: readonly CommentItem[], id: string): CommentItem | undefined {\n  for (const item of items) {\n    if (item.id === id) return item;\n    const nested = findComment(commentReplies(item), id);\n    if (nested) return nested;\n  }\n  return undefined;\n}\n\n/** Depth of a comment. A top-level comment is 1. Missing ids return null. */\nexport function commentDepth(items: readonly CommentItem[], id: string, depth = 1): number | null {\n  for (const item of items) {\n    if (item.id === id) return depth;\n    const nested = commentDepth(commentReplies(item), id, depth + 1);\n    if (nested !== null) return nested;\n  }\n  return null;\n}\n\n/** True when a comment at `depth` can still receive a reply. */\nexport function canReply(depth: number, maxDepth: number): boolean {\n  return depth >= 1 && depth < normalizeMaxDepth(maxDepth);\n}\n\nexport function createComment(input: {\n  id: string;\n  author: CommentAuthor;\n  body: string;\n  createdAt?: CommentItem[\"createdAt\"];\n}): CommentItem | null {\n  const id = input.id.trim();\n  const body = input.body.trim();\n  const name = input.author.name.trim();\n  if (!id || !body || !name) return null;\n  return {\n    id,\n    author: { ...input.author, name },\n    body,\n    createdAt: input.createdAt ?? new Date(),\n    replies: [],\n  };\n}\n\nfunction withReply<T extends CommentItem>(\n  items: readonly T[],\n  parentId: string,\n  comment: T,\n): readonly T[] {\n  for (let index = 0; index < items.length; index += 1) {\n    const item = items[index];\n    if (!item) continue;\n    if (item.id === parentId) {\n      const next = items.slice();\n      next[index] = { ...item, replies: [...commentReplies(item), comment] };\n      return next;\n    }\n    const replies = commentReplies(item);\n    if (!replies.length) continue;\n    const nested = withReply(replies, parentId, comment);\n    if (nested === replies) continue;\n    const next = items.slice();\n    next[index] = { ...item, replies: nested.slice() };\n    return next;\n  }\n  return items;\n}\n\n/**\n * Insert `comment` at the root, or under `parentId`.\n * Returns the same array when the id already exists, the parent is missing,\n * or the parent is already at `maxDepth`.\n */\nexport function addComment<T extends CommentItem>(\n  items: readonly T[],\n  comment: T,\n  parentId: string | null,\n  maxDepth: number,\n): readonly T[] {\n  if (!comment.id || findComment(items, comment.id)) return items;\n  const entry = { ...comment, replies: [...commentReplies(comment)] } as T;\n  if (parentId === null) return [...items, entry];\n  const depth = commentDepth(items, parentId);\n  if (depth === null || !canReply(depth, maxDepth)) return items;\n  return withReply(items, parentId, entry);\n}\n",
      "type": "registry:component"
    },
    {
      "path": "registry/comments-thread/index.ts",
      "content": "export { default as CommentsThread } from \"./CommentsThread.vue\";\nexport type { CommentAuthor, CommentItem } from \"./thread\";\nexport {\n  addComment,\n  canReply,\n  commentDateTime,\n  commentDepth,\n  commentInitials,\n  countComments,\n  createComment,\n  findComment,\n  formatCommentTime,\n} from \"./thread\";\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}
