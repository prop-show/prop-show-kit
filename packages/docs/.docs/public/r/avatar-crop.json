{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "avatar-crop",
  "title": "Avatar Crop",
  "description": "Crop a profile image with pan, zoom, and a circular or square mask.",
  "dependencies": ["@lucide/vue"],
  "registryDependencies": ["button"],
  "files": [
    {
      "path": "registry/avatar-crop/AvatarCrop.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from \"vue\";\n\nimport { ImagePlusIcon } from \"@lucide/vue\";\nimport { computed, onMounted, onUnmounted, shallowRef, useId, useTemplateRef, watch } from \"vue\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { cn } from \"@/lib/utils\";\n\nimport type { AvatarCropResult, CropFrame, ImageSize } from \"./crop\";\n\nimport {\n  coverScale,\n  initialFrame,\n  normalizeOutputSize,\n  panBy,\n  resizeFrame,\n  sourceRect,\n  zoomAt,\n  zoomFactor,\n} from \"./crop\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst props = withDefaults(\n  defineProps<{\n    src?: string;\n    shape?: \"circle\" | \"square\";\n    outputSize?: number;\n    outputType?: \"image/png\" | \"image/jpeg\" | \"image/webp\";\n    quality?: number;\n    background?: string;\n    maxZoom?: number;\n    accept?: string;\n    disabled?: boolean;\n    label?: string;\n    chooseLabel?: string;\n    replaceLabel?: string;\n    zoomLabel?: string;\n    applyLabel?: string;\n    resetLabel?: string;\n    emptyLabel?: string;\n    instructions?: string;\n    loadError?: string;\n    typeError?: string;\n    exportError?: string;\n    class?: HTMLAttributes[\"class\"];\n  }>(),\n  {\n    shape: \"circle\",\n    outputSize: 256,\n    outputType: \"image/png\",\n    quality: 0.92,\n    maxZoom: 4,\n    accept: \"image/png,image/jpeg,image/webp,image/gif\",\n    chooseLabel: \"Choose image\",\n    replaceLabel: \"Replace image\",\n    zoomLabel: \"Zoom\",\n    applyLabel: \"Apply crop\",\n    resetLabel: \"Reset\",\n    emptyLabel: \"No image selected\",\n    instructions:\n      \"Crop image. Drag to move it. Arrow keys move the image. Plus and minus change zoom.\",\n    loadError: \"This image could not be opened.\",\n    typeError: \"Choose an image file.\",\n    exportError: \"The browser blocked reading this image. Choose a file from this device.\",\n  },\n);\n\nconst cropped = defineModel<string | null>({ default: null });\nconst emit = defineEmits<{ crop: [result: AvatarCropResult] }>();\n\nconst viewportEl = useTemplateRef<HTMLElement>(\"viewport\");\nconst fileEl = useTemplateRef<HTMLInputElement>(\"file\");\nconst zoomId = useId();\nconst errorId = useId();\n\nconst workingUrl = shallowRef(props.src ?? \"\");\nconst ownedUrl = shallowRef<string | null>(null);\nconst natural = shallowRef<ImageSize | null>(null);\nconst frame = shallowRef<CropFrame | null>(null);\nconst loadedImage = shallowRef<HTMLImageElement | null>(null);\nconst viewport = shallowRef(0);\nconst error = shallowRef(\"\");\nconst applying = shallowRef(false);\nconst draggingFile = shallowRef(false);\nconst drag = shallowRef<{\n  id: number;\n  x: number;\n  y: number;\n  originX: number;\n  originY: number;\n} | null>(null);\n\nconst zoomValue = computed(() => {\n  if (!frame.value || !natural.value || viewport.value <= 0) return 1;\n  return zoomFactor(frame.value, natural.value, viewport.value);\n});\n\nconst imageStyle = computed(() => {\n  if (!frame.value || !natural.value) return undefined;\n  return {\n    width: `${natural.value.width * frame.value.scale}px`,\n    height: `${natural.value.height * frame.value.scale}px`,\n    maxWidth: \"none\",\n    maxHeight: \"none\",\n    transform: `translate(${frame.value.x}px, ${frame.value.y}px)`,\n  };\n});\n\nfunction releaseOwnedUrl() {\n  if (!ownedUrl.value) return;\n  URL.revokeObjectURL(ownedUrl.value);\n  ownedUrl.value = null;\n}\n\nfunction setWorkingUrl(url: string, owned: boolean) {\n  releaseOwnedUrl();\n  if (owned) ownedUrl.value = url;\n  workingUrl.value = url;\n  error.value = \"\";\n  loadedImage.value = null;\n  natural.value = null;\n  frame.value = null;\n  drag.value = null;\n}\n\nwatch(\n  () => props.src,\n  (src, previous) => {\n    if (!src || src === previous) return;\n    setWorkingUrl(src, false);\n  },\n);\n\nfunction measure() {\n  const next = viewportEl.value?.clientWidth ?? 0;\n  if (next <= 0 || next === viewport.value) return;\n  if (natural.value && frame.value && viewport.value > 0) {\n    frame.value = resizeFrame(frame.value, natural.value, viewport.value, next, props.maxZoom);\n  } else if (natural.value) {\n    frame.value = initialFrame(natural.value, next, 1, props.maxZoom);\n  }\n  viewport.value = next;\n}\n\nlet observer: ResizeObserver | undefined;\nonMounted(() => {\n  measure();\n  if (!viewportEl.value) return;\n  observer = new ResizeObserver(() => measure());\n  observer.observe(viewportEl.value);\n});\nonUnmounted(() => {\n  observer?.disconnect();\n  releaseOwnedUrl();\n});\n\nfunction onLoad(event: Event) {\n  const image = event.currentTarget;\n  if (!(image instanceof HTMLImageElement) || !image.naturalWidth || !image.naturalHeight) {\n    error.value = props.loadError;\n    return;\n  }\n  loadedImage.value = image;\n  natural.value = { width: image.naturalWidth, height: image.naturalHeight };\n  error.value = \"\";\n  const size = viewport.value || viewportEl.value?.clientWidth || 0;\n  if (size > 0) {\n    viewport.value = size;\n    frame.value = initialFrame(natural.value, size, 1, props.maxZoom);\n  }\n}\n\nfunction onImageError() {\n  loadedImage.value = null;\n  natural.value = null;\n  frame.value = null;\n  error.value = props.loadError;\n}\n\nfunction useFile(file: File | undefined) {\n  if (!file || props.disabled) return;\n  if (!file.type.startsWith(\"image/\")) {\n    error.value = props.typeError;\n    return;\n  }\n  setWorkingUrl(URL.createObjectURL(file), true);\n}\n\nfunction onFile(event: Event) {\n  const input = event.currentTarget;\n  if (!(input instanceof HTMLInputElement)) return;\n  useFile(input.files?.[0]);\n  input.value = \"\";\n}\n\nfunction openFileDialog() {\n  fileEl.value?.click();\n}\n\nfunction onDragOver(event: DragEvent) {\n  if (props.disabled) return;\n  event.preventDefault();\n  draggingFile.value = true;\n}\n\nfunction onDragLeave(event: DragEvent) {\n  const next = event.relatedTarget;\n  const current = event.currentTarget;\n  if (current instanceof Node && next instanceof Node && current.contains(next)) return;\n  draggingFile.value = false;\n}\n\nfunction onDrop(event: DragEvent) {\n  if (props.disabled) return;\n  event.preventDefault();\n  draggingFile.value = false;\n  useFile(event.dataTransfer?.files?.[0]);\n}\n\nfunction onPointerDown(event: PointerEvent) {\n  if (props.disabled || !frame.value) return;\n  const target = event.currentTarget;\n  if (!(target instanceof HTMLElement)) return;\n  try {\n    target.setPointerCapture(event.pointerId);\n  } catch {\n    // Capture needs an active pointer. Drag still follows this pointer id.\n  }\n  drag.value = {\n    id: event.pointerId,\n    x: event.clientX,\n    y: event.clientY,\n    originX: frame.value.x,\n    originY: frame.value.y,\n  };\n}\n\nfunction onPointerMove(event: PointerEvent) {\n  const current = drag.value;\n  if (!current || current.id !== event.pointerId || !frame.value || !natural.value) return;\n  frame.value = panBy(\n    { ...frame.value, x: current.originX, y: current.originY },\n    event.clientX - current.x,\n    event.clientY - current.y,\n    natural.value,\n    viewport.value,\n    props.maxZoom,\n  );\n}\n\nfunction onPointerUp(event: PointerEvent) {\n  if (drag.value?.id === event.pointerId) drag.value = null;\n}\n\nfunction move(dx: number, dy: number) {\n  if (!frame.value || !natural.value) return;\n  frame.value = panBy(frame.value, dx, dy, natural.value, viewport.value, props.maxZoom);\n}\n\nfunction zoomBy(multiplier: number) {\n  if (!frame.value || !natural.value || viewport.value <= 0) return;\n  frame.value = zoomAt(\n    frame.value,\n    natural.value,\n    viewport.value,\n    frame.value.scale * multiplier,\n    viewport.value / 2,\n    viewport.value / 2,\n    props.maxZoom,\n  );\n}\n\nfunction onZoomInput(event: Event) {\n  const value = Number((event.currentTarget as HTMLInputElement).value);\n  if (!frame.value || !natural.value || viewport.value <= 0) return;\n  frame.value = zoomAt(\n    frame.value,\n    natural.value,\n    viewport.value,\n    coverScale(natural.value, viewport.value) * value,\n    viewport.value / 2,\n    viewport.value / 2,\n    props.maxZoom,\n  );\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  if (props.disabled || !frame.value) return;\n  const key = event.key;\n  if (key === \"ArrowLeft\") move(-12, 0);\n  else if (key === \"ArrowRight\") move(12, 0);\n  else if (key === \"ArrowUp\") move(0, -12);\n  else if (key === \"ArrowDown\") move(0, 12);\n  else if (key === \"+\" || key === \"=\") zoomBy(1.1);\n  else if (key === \"-\" || key === \"_\") zoomBy(1 / 1.1);\n  else if (key === \"Home\") reset();\n  else return;\n  event.preventDefault();\n}\n\nfunction onWheel(event: WheelEvent) {\n  if (props.disabled || !frame.value || !natural.value || !viewportEl.value) return;\n  const bounds = viewportEl.value.getBoundingClientRect();\n  const next = frame.value.scale * (event.deltaY < 0 ? 1.08 : 1 / 1.08);\n  frame.value = zoomAt(\n    frame.value,\n    natural.value,\n    viewport.value,\n    next,\n    event.clientX - bounds.left,\n    event.clientY - bounds.top,\n    props.maxZoom,\n  );\n}\n\nfunction reset() {\n  if (!natural.value || viewport.value <= 0) return;\n  frame.value = initialFrame(natural.value, viewport.value, 1, props.maxZoom);\n  error.value = \"\";\n}\n\nfunction backgroundColor() {\n  if (props.background) return props.background;\n  if (props.outputType === \"image/jpeg\") return \"#ffffff\";\n  return \"\";\n}\n\nasync function apply() {\n  const image = loadedImage.value;\n  const current = frame.value;\n  const size = viewport.value;\n  if (!image || !current || size <= 0 || props.disabled || applying.value) return;\n  const output = normalizeOutputSize(props.outputSize);\n  const canvas = document.createElement(\"canvas\");\n  canvas.width = output;\n  canvas.height = output;\n  const context = canvas.getContext(\"2d\");\n  if (!context) {\n    error.value = props.exportError;\n    return;\n  }\n  const fill = backgroundColor();\n  if (fill) {\n    context.fillStyle = fill;\n    context.fillRect(0, 0, output, output);\n  }\n  context.save();\n  if (props.shape === \"circle\") {\n    context.beginPath();\n    context.arc(output / 2, output / 2, output / 2, 0, Math.PI * 2);\n    context.clip();\n  }\n  context.imageSmoothingEnabled = true;\n  context.imageSmoothingQuality = \"high\";\n  const rect = sourceRect(current, size);\n  context.drawImage(image, rect.x, rect.y, rect.size, rect.size, 0, 0, output, output);\n  context.restore();\n\n  applying.value = true;\n  try {\n    const dataUrl = canvas.toDataURL(props.outputType, props.quality);\n    const blob = await new Promise<Blob | null>((resolve) => {\n      canvas.toBlob(resolve, props.outputType, props.quality);\n    });\n    if (!blob) {\n      error.value = props.exportError;\n      return;\n    }\n    error.value = \"\";\n    cropped.value = dataUrl;\n    emit(\"crop\", { blob, dataUrl, width: output, height: output });\n  } catch {\n    error.value = props.exportError;\n  } finally {\n    applying.value = false;\n  }\n}\n</script>\n\n<template>\n  <div\n    data-slot=\"avatar-crop\"\n    :class=\"\n      cn('grid w-full max-w-xs gap-3', draggingFile && 'rounded-lg ring-2 ring-ring', props.class)\n    \"\n    @dragover=\"onDragOver\"\n    @dragleave=\"onDragLeave\"\n    @drop=\"onDrop\"\n  >\n    <label v-if=\"props.label\" class=\"text-sm font-medium text-foreground\">{{ props.label }}</label>\n\n    <input\n      ref=\"file\"\n      type=\"file\"\n      class=\"sr-only\"\n      :accept=\"props.accept\"\n      :disabled=\"props.disabled\"\n      :aria-label=\"natural ? props.replaceLabel : props.chooseLabel\"\n      @change=\"onFile\"\n    />\n\n    <div\n      ref=\"viewport\"\n      data-slot=\"avatar-crop-viewport\"\n      role=\"application\"\n      tabindex=\"0\"\n      :aria-label=\"props.instructions\"\n      :aria-disabled=\"props.disabled || undefined\"\n      :aria-describedby=\"error ? errorId : undefined\"\n      class=\"relative aspect-square w-full touch-none overflow-hidden bg-muted outline-none select-none focus-visible:ring-3 focus-visible:ring-ring/50\"\n      :class=\"[\n        props.shape === 'circle' ? 'rounded-full' : 'rounded-lg',\n        natural ? 'cursor-grab active:cursor-grabbing' : 'cursor-default',\n        props.disabled && 'pointer-events-none opacity-50',\n      ]\"\n      @pointerdown=\"onPointerDown\"\n      @pointermove=\"onPointerMove\"\n      @pointerup=\"onPointerUp\"\n      @pointercancel=\"onPointerUp\"\n      @keydown=\"onKeydown\"\n      @wheel.prevent=\"onWheel\"\n    >\n      <img\n        v-if=\"workingUrl\"\n        :src=\"workingUrl\"\n        alt=\"\"\n        draggable=\"false\"\n        class=\"pointer-events-none absolute top-0 left-0 max-w-none\"\n        :style=\"imageStyle\"\n        @load=\"onLoad\"\n        @error=\"onImageError\"\n      />\n      <div v-else class=\"grid h-full place-items-center px-6 text-center text-muted-foreground\">\n        <slot name=\"empty\">\n          <span class=\"flex flex-col items-center gap-2 text-sm\">\n            <ImagePlusIcon class=\"size-6\" />\n            {{ props.emptyLabel }}\n          </span>\n        </slot>\n      </div>\n    </div>\n\n    <div class=\"grid gap-1.5\">\n      <div class=\"flex items-center justify-between gap-3 text-xs text-muted-foreground\">\n        <label :for=\"zoomId\">{{ props.zoomLabel }}</label>\n        <span class=\"tabular-nums\">{{ Math.round(zoomValue * 100) }}%</span>\n      </div>\n      <input\n        :id=\"zoomId\"\n        type=\"range\"\n        min=\"1\"\n        :max=\"props.maxZoom\"\n        step=\"0.01\"\n        :value=\"zoomValue\"\n        :disabled=\"props.disabled || !natural\"\n        :aria-valuetext=\"`${Math.round(zoomValue * 100)} percent`\"\n        class=\"h-2 w-full cursor-pointer accent-primary disabled:cursor-not-allowed disabled:opacity-50\"\n        @input=\"onZoomInput\"\n      />\n    </div>\n\n    <p v-if=\"error\" :id=\"errorId\" role=\"alert\" class=\"text-sm text-destructive\">{{ error }}</p>\n\n    <div class=\"flex flex-wrap gap-2\">\n      <Button\n        type=\"button\"\n        variant=\"outline\"\n        size=\"sm\"\n        :disabled=\"props.disabled\"\n        @click=\"openFileDialog\"\n      >\n        {{ natural ? props.replaceLabel : props.chooseLabel }}\n      </Button>\n      <Button\n        type=\"button\"\n        variant=\"outline\"\n        size=\"sm\"\n        :disabled=\"props.disabled || !natural\"\n        @click=\"reset\"\n      >\n        {{ props.resetLabel }}\n      </Button>\n      <Button\n        type=\"button\"\n        size=\"sm\"\n        :disabled=\"props.disabled || !natural || applying\"\n        @click=\"apply\"\n      >\n        {{ props.applyLabel }}\n      </Button>\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/avatar-crop/crop.ts",
      "content": "// Original crop geometry for a square viewport. The image always covers the\n// window: zoom is a multiple of the cover scale, and pan is clamped to that cover.\n\nexport interface ImageSize {\n  width: number;\n  height: number;\n}\n\nexport interface CropFrame {\n  /** Left edge of the source image, in viewport pixels. */\n  x: number;\n  /** Top edge of the source image, in viewport pixels. */\n  y: number;\n  /** Viewport pixels per source pixel. */\n  scale: number;\n}\n\nexport interface SourceRect {\n  x: number;\n  y: number;\n  size: number;\n}\n\nexport interface AvatarCropResult {\n  blob: Blob;\n  dataUrl: string;\n  width: number;\n  height: number;\n}\n\nexport function coverScale(image: ImageSize, viewport: number): number {\n  if (image.width <= 0 || image.height <= 0 || viewport <= 0) return 1;\n  return Math.max(viewport / image.width, viewport / image.height);\n}\n\nexport function normalizeOutputSize(size: number): number {\n  if (!Number.isFinite(size)) return 256;\n  return Math.min(4096, Math.max(16, Math.round(size)));\n}\n\nexport function clampScale(\n  scale: number,\n  image: ImageSize,\n  viewport: number,\n  maxZoom: number,\n): number {\n  const min = coverScale(image, viewport);\n  const max = min * Math.max(1, maxZoom);\n  if (!Number.isFinite(scale)) return min;\n  return Math.min(max, Math.max(min, scale));\n}\n\nfunction clampOffset(offset: number, displayed: number, viewport: number): number {\n  if (displayed <= viewport) return (viewport - displayed) / 2;\n  return Math.min(0, Math.max(viewport - displayed, offset));\n}\n\nexport function clampFrame(\n  frame: CropFrame,\n  image: ImageSize,\n  viewport: number,\n  maxZoom = 4,\n): CropFrame {\n  const scale = clampScale(frame.scale, image, viewport, maxZoom);\n  return {\n    scale,\n    x: clampOffset(frame.x, image.width * scale, viewport),\n    y: clampOffset(frame.y, image.height * scale, viewport),\n  };\n}\n\nexport function initialFrame(image: ImageSize, viewport: number, zoom = 1, maxZoom = 4): CropFrame {\n  const scale = coverScale(image, viewport) * zoom;\n  return clampFrame(\n    {\n      scale,\n      x: (viewport - image.width * scale) / 2,\n      y: (viewport - image.height * scale) / 2,\n    },\n    image,\n    viewport,\n    maxZoom,\n  );\n}\n\nexport function panBy(\n  frame: CropFrame,\n  dx: number,\n  dy: number,\n  image: ImageSize,\n  viewport: number,\n  maxZoom = 4,\n): CropFrame {\n  return clampFrame({ ...frame, x: frame.x + dx, y: frame.y + dy }, image, viewport, maxZoom);\n}\n\n/** Keep the source pixel under (originX, originY) fixed while changing scale. */\nexport function zoomAt(\n  frame: CropFrame,\n  image: ImageSize,\n  viewport: number,\n  nextScale: number,\n  originX: number,\n  originY: number,\n  maxZoom = 4,\n): CropFrame {\n  const current = frame.scale > 0 ? frame.scale : coverScale(image, viewport);\n  const scale = clampScale(nextScale, image, viewport, maxZoom);\n  return clampFrame(\n    {\n      scale,\n      x: originX - ((originX - frame.x) / current) * scale,\n      y: originY - ((originY - frame.y) / current) * scale,\n    },\n    image,\n    viewport,\n    maxZoom,\n  );\n}\n\nexport function zoomFactor(frame: CropFrame, image: ImageSize, viewport: number): number {\n  const min = coverScale(image, viewport);\n  if (min <= 0 || frame.scale <= 0) return 1;\n  return frame.scale / min;\n}\n\nexport function sourceRect(frame: CropFrame, viewport: number): SourceRect {\n  const scale = frame.scale > 0 ? frame.scale : 1;\n  return {\n    x: -frame.x / scale,\n    y: -frame.y / scale,\n    size: viewport / scale,\n  };\n}\n\n/** Preserve the source point under the viewport center when the viewport size changes. */\nexport function resizeFrame(\n  frame: CropFrame,\n  image: ImageSize,\n  previousViewport: number,\n  nextViewport: number,\n  maxZoom = 4,\n): CropFrame {\n  if (previousViewport <= 0 || nextViewport <= 0 || frame.scale <= 0) {\n    return initialFrame(image, Math.max(nextViewport, previousViewport, 0), 1, maxZoom);\n  }\n  const factor = zoomFactor(frame, image, previousViewport);\n  const sourceX = (previousViewport / 2 - frame.x) / frame.scale;\n  const sourceY = (previousViewport / 2 - frame.y) / frame.scale;\n  const scale = coverScale(image, nextViewport) * factor;\n  return clampFrame(\n    {\n      scale,\n      x: nextViewport / 2 - sourceX * scale,\n      y: nextViewport / 2 - sourceY * scale,\n    },\n    image,\n    nextViewport,\n    maxZoom,\n  );\n}\n",
      "type": "registry:component"
    },
    {
      "path": "registry/avatar-crop/index.ts",
      "content": "export { default as AvatarCrop } from \"./AvatarCrop.vue\";\n\nexport {\n  clampFrame,\n  coverScale,\n  initialFrame,\n  normalizeOutputSize,\n  panBy,\n  resizeFrame,\n  sourceRect,\n  zoomAt,\n  zoomFactor,\n} from \"./crop\";\n\nexport type { AvatarCropResult, CropFrame, ImageSize, SourceRect } from \"./crop\";\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}
