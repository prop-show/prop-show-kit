{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pricing-table",
  "title": "Pricing Table",
  "description": "A responsive feature comparison table with mobile pricing cards.",
  "dependencies": ["@lucide/vue", "@vueuse/core"],
  "registryDependencies": ["https://kit.prop.show/r/pricing-plan.json"],
  "files": [
    {
      "path": "registry/pricing-table/PricingTable.vue",
      "content": "<script setup lang=\"ts\" generic=\"T extends PricingTableTier\">\nimport { createReusableTemplate } from \"@vueuse/core\";\nimport { useSlots } from \"vue\";\nimport TierHeader from \"./PricingTableTier.vue\";\nimport PricingTableFeatureValue from \"./PricingTableFeatureValue.vue\";\nimport { cn } from \"@/lib/utils\";\nimport type {\n  PricingTableFeatureSlotProps,\n  PricingTableFeatureValueSlotProps,\n  PricingTableProps,\n  PricingTableSectionSlotProps,\n  PricingTableSlots,\n  PricingTableTier,\n} from \"./index\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst props = withDefaults(defineProps<PricingTableProps<T>>(), {\n  as: \"div\",\n  caption: \"Pricing plan comparison\",\n  sections: () => [],\n});\ndefineSlots<PricingTableSlots<T>>();\nconst slots = useSlots();\n\nconst [DefineSectionTitle, SectionTitle] =\n  createReusableTemplate<PricingTableSectionSlotProps<T>>();\nconst [DefineFeatureTitle, FeatureTitle] =\n  createReusableTemplate<PricingTableFeatureSlotProps<T>>();\nconst [DefineFeatureValue, FeatureValue] = createReusableTemplate<{\n  cell: PricingTableFeatureValueSlotProps<T>;\n}>();\n\nfunction itemId(item: { id?: string; title: string }) {\n  return (\n    item.id ??\n    item.title\n      .toLowerCase()\n      .trim()\n      .replace(/[^\\p{L}\\p{N}]+/gu, \"-\")\n      .replace(/^-|-$/g, \"\")\n  );\n}\n</script>\n\n<template>\n  <DefineSectionTitle v-slot=\"{ section }\">\n    <slot\n      :name=\"\n        (slots[`section-${itemId(section)}-title`]\n          ? `section-${itemId(section)}-title`\n          : 'section-title') as 'section-title'\n      \"\n      :section=\"section\"\n    >\n      {{ section.title }}\n    </slot>\n  </DefineSectionTitle>\n\n  <DefineFeatureTitle v-slot=\"{ section, feature }\">\n    <slot\n      :name=\"\n        (slots[`feature-${itemId(feature)}-title`]\n          ? `feature-${itemId(feature)}-title`\n          : 'feature-title') as 'feature-title'\n      \"\n      :section=\"section\"\n      :feature=\"feature\"\n    >\n      {{ feature.title }}\n    </slot>\n  </DefineFeatureTitle>\n\n  <DefineFeatureValue v-slot=\"{ cell: { section, feature, tier, value } }\">\n    <slot\n      :name=\"\n        (slots[`feature-${itemId(feature)}-value`]\n          ? `feature-${itemId(feature)}-value`\n          : 'feature-value') as 'feature-value'\n      \"\n      :section=\"section\"\n      :feature=\"feature\"\n      :tier=\"tier\"\n      :value=\"value\"\n    >\n      <PricingTableFeatureValue :value=\"value\" />\n    </slot>\n  </DefineFeatureValue>\n\n  <component\n    :is=\"props.as\"\n    v-bind=\"$attrs\"\n    data-slot=\"pricing-table\"\n    :class=\"cn('relative w-full text-foreground', props.class)\"\n  >\n    <div class=\"pricing-table-desktop\">\n      <table class=\"h-fit w-full table-fixed border-separate border-spacing-0\">\n        <caption class=\"sr-only\">\n          <slot name=\"caption\">{{ props.caption }}</slot>\n        </caption>\n        <thead>\n          <tr>\n            <td />\n            <th\n              v-for=\"tier in props.tiers\"\n              :key=\"tier.id\"\n              scope=\"col\"\n              :data-highlight=\"tier.highlight || undefined\"\n              :class=\"\n                cn(\n                  'p-6 text-start align-top font-normal [overflow-wrap:anywhere]',\n                  tier.highlight && 'rounded-t-lg border-x border-t bg-muted/50',\n                )\n              \"\n            >\n              <TierHeader :tier=\"tier\">\n                <template v-for=\"name in Object.keys(slots)\" :key=\"name\" #[name]=\"scope\">\n                  <slot :name=\"name as 'tier'\" v-bind=\"scope\" />\n                </template>\n              </TierHeader>\n            </th>\n          </tr>\n        </thead>\n        <tbody v-for=\"(section, sectionIndex) in props.sections\" :key=\"itemId(section)\">\n          <tr>\n            <th scope=\"rowgroup\" class=\"border-b py-4 pt-8 text-start text-sm font-semibold\">\n              <SectionTitle :section=\"section\" />\n            </th>\n            <td\n              v-for=\"tier in props.tiers\"\n              :key=\"tier.id\"\n              :data-highlight=\"tier.highlight || undefined\"\n              :class=\"\n                cn(\n                  'border-b px-6 py-4 pt-8',\n                  tier.highlight && 'border-x bg-muted/50',\n                  tier.highlight &&\n                    !section.features.length &&\n                    sectionIndex === props.sections.length - 1 &&\n                    'rounded-b-lg',\n                )\n              \"\n            />\n          </tr>\n          <tr v-for=\"(feature, featureIndex) in section.features\" :key=\"itemId(feature)\">\n            <th\n              scope=\"row\"\n              class=\"border-b py-4 pr-4 text-start text-sm font-normal [overflow-wrap:anywhere]\"\n            >\n              <FeatureTitle :section=\"section\" :feature=\"feature\" />\n            </th>\n            <td\n              v-for=\"tier in props.tiers\"\n              :key=\"tier.id\"\n              :data-highlight=\"tier.highlight || undefined\"\n              :class=\"\n                cn(\n                  'border-b px-6 py-4 text-center text-sm text-muted-foreground',\n                  tier.highlight && 'border-x bg-muted/50',\n                  tier.highlight &&\n                    sectionIndex === props.sections.length - 1 &&\n                    featureIndex === section.features.length - 1 &&\n                    'rounded-b-lg',\n                )\n              \"\n            >\n              <div class=\"flex items-center justify-center gap-1 [overflow-wrap:anywhere]\">\n                <FeatureValue\n                  :cell=\"{ section, feature, tier, value: feature.tiers[tier.id as T['id']] }\"\n                />\n              </div>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <div\n      class=\"pricing-table-mobile flex w-full flex-col gap-6\"\n      role=\"group\"\n      :aria-label=\"props.caption\"\n    >\n      <article\n        v-for=\"tier in props.tiers\"\n        :key=\"tier.id\"\n        :aria-label=\"tier.title ?? tier.id\"\n        :class=\"\n          cn(\n            'min-w-0 rounded-lg border p-6 [overflow-wrap:anywhere]',\n            tier.highlight && 'bg-muted/50',\n          )\n        \"\n      >\n        <TierHeader :tier=\"tier\">\n          <template v-for=\"name in Object.keys(slots)\" :key=\"name\" #[name]=\"scope\">\n            <slot :name=\"name as 'tier'\" v-bind=\"scope\" />\n          </template>\n        </TierHeader>\n        <section v-for=\"section in props.sections\" :key=\"itemId(section)\" class=\"mt-6 space-y-3\">\n          <h3 class=\"text-sm font-semibold\">\n            <SectionTitle :section=\"section\" />\n          </h3>\n          <dl class=\"space-y-3\">\n            <div\n              v-for=\"feature in section.features\"\n              :key=\"itemId(feature)\"\n              class=\"flex items-start justify-between gap-4 text-sm\"\n            >\n              <dt class=\"min-w-0\">\n                <FeatureTitle :section=\"section\" :feature=\"feature\" />\n              </dt>\n              <dd\n                class=\"flex min-w-5 items-center justify-end gap-1 text-end text-muted-foreground\"\n              >\n                <FeatureValue\n                  :cell=\"{ section, feature, tier, value: feature.tiers[tier.id as T['id']] }\"\n                />\n              </dd>\n            </div>\n          </dl>\n        </section>\n      </article>\n    </div>\n  </component>\n</template>\n\n<style scoped>\n[data-slot=\"pricing-table\"] {\n  container-type: inline-size;\n}\n\n.pricing-table-desktop {\n  display: none;\n}\n\n/* Own table geometry even inside Markdown typography containers. */\n[data-slot=\"pricing-table\"] table {\n  display: table;\n  width: 100%;\n  height: 1px;\n  table-layout: fixed;\n  border-collapse: separate;\n  border-spacing: 0;\n  border: 0;\n  margin: 0;\n  overflow: visible;\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n}\n\n[data-slot=\"pricing-table\"] :is(thead, tbody, tr) {\n  border: 0;\n  background: transparent;\n}\n\n[data-slot=\"pricing-table\"] :is(th, td) {\n  border: 0 solid var(--border);\n  border-bottom-width: 1px;\n  padding: 1rem 1.5rem;\n  background: transparent;\n  color: inherit;\n  font-weight: 400;\n  text-align: center;\n  overflow-wrap: anywhere;\n}\n\n[data-slot=\"pricing-table\"] thead :is(th, td) {\n  height: 100%;\n  border-bottom-width: 0;\n  padding: 1.5rem;\n  text-align: start;\n  vertical-align: top;\n}\n\n[data-slot=\"pricing-table\"] tbody th {\n  padding-inline: 0 1rem;\n  text-align: start;\n}\n\n[data-slot=\"pricing-table\"] th[scope=\"rowgroup\"] {\n  font-weight: 600;\n}\n\n[data-slot=\"pricing-table\"] tbody + tbody tr:first-child > * {\n  padding-top: 2rem;\n}\n\n[data-slot=\"pricing-table\"] [data-highlight=\"true\"] {\n  border-inline-width: 1px;\n  background: color-mix(in oklab, var(--muted) 50%, transparent);\n}\n\n[data-slot=\"pricing-table\"] thead [data-highlight=\"true\"] {\n  border-top-width: 1px;\n  border-start-start-radius: var(--radius);\n  border-start-end-radius: var(--radius);\n}\n\n[data-slot=\"pricing-table\"] tbody:last-child tr:last-child [data-highlight=\"true\"],\n[data-slot=\"pricing-table\"] table:not(:has(tbody)) thead [data-highlight=\"true\"] {\n  border-bottom-width: 1px;\n  border-end-start-radius: var(--radius);\n  border-end-end-radius: var(--radius);\n}\n\n[data-slot=\"pricing-table\"] :is(h3, p, dl, dt, dd) {\n  margin: 0;\n}\n\n[data-slot=\"pricing-table\"] h3 {\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  font-weight: 600;\n}\n\n@container (min-width: 640px) {\n  .pricing-table-desktop {\n    display: block;\n  }\n\n  .pricing-table-mobile {\n    display: none;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/pricing-table/PricingTableTier.vue",
      "content": "<script setup lang=\"ts\" generic=\"T extends PricingTableTier\">\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport type { VNode } from \"vue\";\nimport type { PricingTableTier, PricingTableTierSlot, PricingTableTierSlotProps } from \"./index\";\n\ndefineProps<PricingTableTierSlotProps<T>>();\nconst slots =\n  defineSlots<Partial<Record<string, (props: PricingTableTierSlotProps<T>) => VNode[]>>>();\n\nfunction tierSlotName(tier: T, name: PricingTableTierSlot) {\n  return slots[`${tier.id}-${name}`] ? `${tier.id}-${name}` : `tier-${name}`;\n}\n</script>\n\n<template>\n  <div data-slot=\"pricing-table-tier\" class=\"pricing-table-tier\">\n    <slot :name=\"slots[tier.id] ? tier.id : 'tier'\" :tier=\"tier\">\n      <div class=\"pricing-table-tier-title-wrapper\">\n        <div data-slot=\"pricing-table-tier-title\">\n          <slot :name=\"tierSlotName(tier, 'title')\" :tier=\"tier\">{{ tier.title }}</slot>\n        </div>\n        <slot :name=\"tierSlotName(tier, 'badge')\" :tier=\"tier\">\n          <Badge\n            v-if=\"tier.badge\"\n            :variant=\"\n              typeof tier.badge === 'string' ? 'secondary' : (tier.badge.variant ?? 'secondary')\n            \"\n            class=\"truncate\"\n            >{{ typeof tier.badge === \"string\" ? tier.badge : tier.badge.label }}</Badge\n          >\n        </slot>\n      </div>\n      <div data-slot=\"pricing-table-tier-description\">\n        <slot :name=\"tierSlotName(tier, 'description')\" :tier=\"tier\">{{ tier.description }}</slot>\n      </div>\n      <div class=\"pricing-table-tier-price-wrapper\">\n        <del\n          v-if=\"\n            (tier.discount != null && tier.price != null) || slots[tierSlotName(tier, 'discount')]\n          \"\n          data-slot=\"pricing-table-tier-discount\"\n          ><slot :name=\"tierSlotName(tier, 'discount')\" :tier=\"tier\">{{ tier.price }}</slot></del\n        >\n        <span\n          v-if=\"tier.discount != null || tier.price != null || slots[tierSlotName(tier, 'price')]\"\n          data-slot=\"pricing-table-tier-price\"\n          ><slot :name=\"tierSlotName(tier, 'price')\" :tier=\"tier\">{{\n            tier.discount ?? tier.price\n          }}</slot></span\n        >\n        <div\n          v-if=\"tier.billingCycle || tier.billingPeriod || slots[tierSlotName(tier, 'billing')]\"\n          class=\"pricing-table-tier-billing\"\n        >\n          <slot :name=\"tierSlotName(tier, 'billing')\" :tier=\"tier\">\n            <span class=\"font-medium\">{{ tier.billingPeriod || \"\\u00a0\" }}</span>\n            <span v-if=\"tier.billingCycle\">{{ tier.billingCycle }}</span>\n          </slot>\n        </div>\n      </div>\n      <div\n        v-if=\"tier.button || slots[tierSlotName(tier, 'button')]\"\n        class=\"pricing-table-tier-button\"\n      >\n        <slot :name=\"tierSlotName(tier, 'button')\" :tier=\"tier\">\n          <Button\n            v-if=\"tier.button\"\n            v-bind=\"tier.button\"\n            :as=\"tier.button.href && !tier.button.disabled ? 'a' : 'button'\"\n            :href=\"tier.button.disabled ? undefined : tier.button.href\"\n            :type=\"tier.button.href && !tier.button.disabled ? undefined : 'button'\"\n            :size=\"tier.button.size ?? 'lg'\"\n            class=\"w-full\"\n            >{{ tier.button.label }}</Button\n          >\n        </slot>\n      </div>\n    </slot>\n  </div>\n</template>\n\n<style scoped>\n.pricing-table-tier {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  text-align: start;\n}\n\n.pricing-table-tier-title-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n[data-slot=\"pricing-table-tier-title\"] {\n  min-width: 0;\n  font-size: 1.125rem;\n  line-height: 1.75rem;\n  font-weight: 600;\n}\n\n[data-slot=\"pricing-table-tier-description\"] {\n  margin-top: 0.25rem;\n  color: var(--muted-foreground);\n  font-size: 0.875rem;\n  line-height: 1.25rem;\n  font-weight: 400;\n}\n\n.pricing-table-tier-price-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n  margin-top: 1rem;\n}\n\n[data-slot=\"pricing-table-tier-price\"] {\n  flex-shrink: 0;\n  font-size: 2.25rem;\n  line-height: 2.5rem;\n  font-weight: 600;\n}\n\n.pricing-table-tier-price-wrapper:has([data-slot=\"pricing-table-tier-discount\"]) {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n}\n\n[data-slot=\"pricing-table-tier-discount\"] {\n  grid-column: 1 / -1;\n  white-space: nowrap;\n  color: var(--muted-foreground);\n  font-size: 1.5rem;\n  line-height: 2rem;\n  text-decoration: line-through;\n}\n\n.pricing-table-tier-billing {\n  display: flex;\n  min-width: 0;\n  flex: 1;\n  flex-direction: column;\n  justify-content: space-between;\n  color: var(--muted-foreground);\n  font-size: 0.75rem;\n  line-height: 1rem;\n}\n\n.pricing-table-tier-billing > span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.pricing-table-tier-button {\n  margin-top: 1.5rem;\n}\n\n@container (min-width: 640px) {\n  .pricing-table-tier {\n    height: 100%;\n  }\n\n  [data-slot=\"pricing-table-tier-description\"] {\n    flex: 1;\n  }\n\n  .pricing-table-tier-button {\n    margin-top: auto;\n    padding-top: 1.5rem;\n  }\n}\n</style>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/pricing-table/PricingTableFeatureValue.vue",
      "content": "<script setup lang=\"ts\">\nimport { CircleCheckIcon, MinusIcon } from \"@lucide/vue\";\nimport { cn } from \"@/lib/utils\";\nimport type { PricingTableFeatureValue } from \"./index\";\n\ndefineProps<{ value: PricingTableFeatureValue | undefined }>();\n</script>\n\n<template>\n  <template v-if=\"typeof value === 'boolean'\">\n    <component\n      :is=\"value ? CircleCheckIcon : MinusIcon\"\n      aria-hidden=\"true\"\n      :class=\"cn('size-5 shrink-0', value ? 'text-primary' : 'text-muted-foreground')\"\n    />\n    <span class=\"sr-only\">{{ value ? \"Included\" : \"Not included\" }}</span>\n  </template>\n  <template v-else>{{ value ?? \"—\" }}</template>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/pricing-table/index.ts",
      "content": "import type { Component, HTMLAttributes, VNode } from \"vue\";\nimport type { PricingPlanBadge, PricingPlanButton } from \"@/components/pricing-plan\";\n\nexport { default as PricingTable } from \"./PricingTable.vue\";\n\nexport interface PricingTableTier {\n  id: string;\n  title?: string;\n  description?: string;\n  badge?: string | PricingPlanBadge;\n  billingCycle?: string;\n  billingPeriod?: string;\n  price?: string;\n  discount?: string;\n  button?: PricingPlanButton;\n  highlight?: boolean;\n}\n\nexport type PricingTableFeatureValue = string | number | boolean;\n\nexport interface PricingTableSectionFeature<T extends PricingTableTier = PricingTableTier> {\n  id?: string;\n  title: string;\n  tiers: Partial<Record<T[\"id\"], PricingTableFeatureValue>>;\n}\n\nexport interface PricingTableSection<T extends PricingTableTier = PricingTableTier> {\n  id?: string;\n  title: string;\n  features: PricingTableSectionFeature<T>[];\n}\n\nexport interface PricingTableProps<T extends PricingTableTier = PricingTableTier> {\n  tiers: T[];\n  sections?: PricingTableSection<T>[];\n  as?: string | Component;\n  caption?: string;\n  class?: HTMLAttributes[\"class\"];\n}\n\nexport type PricingTableTierSlot =\n  | \"title\"\n  | \"description\"\n  | \"badge\"\n  | \"button\"\n  | \"billing\"\n  | \"discount\"\n  | \"price\";\n\nexport interface PricingTableTierSlotProps<T extends PricingTableTier = PricingTableTier> {\n  tier: T;\n}\n\nexport interface PricingTableSectionSlotProps<T extends PricingTableTier = PricingTableTier> {\n  section: PricingTableSection<T>;\n}\n\nexport interface PricingTableFeatureSlotProps<\n  T extends PricingTableTier = PricingTableTier,\n> extends PricingTableSectionSlotProps<T> {\n  feature: PricingTableSectionFeature<T>;\n}\n\nexport interface PricingTableFeatureValueSlotProps<T extends PricingTableTier = PricingTableTier>\n  extends PricingTableFeatureSlotProps<T>, PricingTableTierSlotProps<T> {\n  value: PricingTableFeatureValue | undefined;\n}\n\ntype Slot<Props> = (props: Props) => VNode[];\n\ntype PricingTableNamedSlots<T extends PricingTableTier> = {\n  caption?: Slot<Record<string, never>>;\n  tier?: Slot<PricingTableTierSlotProps<T>>;\n  \"section-title\"?: Slot<PricingTableSectionSlotProps<T>>;\n  \"feature-title\"?: Slot<PricingTableFeatureSlotProps<T>>;\n  \"feature-value\"?: Slot<PricingTableFeatureValueSlotProps<T>>;\n} & Partial<Record<`tier-${PricingTableTierSlot}`, Slot<PricingTableTierSlotProps<T>>>> &\n  Partial<Record<`section-${string}-title`, Slot<PricingTableSectionSlotProps<T>>>> &\n  Partial<Record<`feature-${string}-title`, Slot<PricingTableFeatureSlotProps<T>>>> &\n  Partial<Record<`feature-${string}-value`, Slot<PricingTableFeatureValueSlotProps<T>>>>;\n\nexport type PricingTableSlots<T extends PricingTableTier = PricingTableTier> =\n  PricingTableNamedSlots<T> &\n    Partial<\n      Record<\n        T[\"id\"] | `${T[\"id\"]}-${PricingTableTierSlot}`,\n        string extends T[\"id\"]\n          ? PricingTableNamedSlots<T>[keyof PricingTableNamedSlots<T>]\n          : Slot<PricingTableTierSlotProps<T>>\n      >\n    >;\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}
