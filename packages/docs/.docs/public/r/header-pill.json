{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "header-pill",
  "title": "Pill Header",
  "description": "A rounded header with compact mega menus and pill-shaped account actions.",
  "dependencies": ["@lucide/vue", "@vueuse/core", "reka-ui"],
  "registryDependencies": ["button"],
  "files": [
    {
      "path": "registry/header/HeaderPill.vue",
      "content": "<!--\nMIT License\n\nCopyright (c) 2026 SikandarJODD\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n-->\n<script setup lang=\"ts\">\nimport { Button } from \"@/components/ui/button\";\nimport HeaderLogo from \"./HeaderLogo.vue\";\nimport HeaderMobileNav from \"./HeaderMobileNav.vue\";\nimport { useHeaderScroll } from \"./useHeaderScroll\";\nimport HeaderDesktopNav from \"./HeaderDesktopNav.vue\";\nwithDefaults(\n  defineProps<{\n    homeHref?: string;\n    homeLabel?: string;\n    signInHref?: string;\n    signUpHref?: string;\n  }>(),\n  { homeHref: \"/\", homeLabel: \"Home\", signInHref: \"/login\", signUpHref: \"/signup\" },\n);\nconst { scrolled } = useHeaderScroll(10);\n</script>\n<template>\n  <header\n    ref=\"header\"\n    class=\"sticky top-0 z-50 mx-auto w-full max-w-5xl border-b border-border shadow-sm backdrop-blur-sm transition-[max-width] duration-300 ease-out supports-backdrop-filter:bg-background/50 md:transition-all md:ease-out text-foreground motion-reduce:transition-none\"\n    :class=\"\n      scrolled\n        ? 'rounded-full border border-border bg-background/95 backdrop-blur-sm supports-backdrop-filter:bg-background/50 md:top-2 md:max-w-4xl md:shadow'\n        : ''\n    \"\n  >\n    <nav\n      aria-label=\"Site navigation\"\n      class=\"flex h-14 w-full items-center justify-between gap-2 px-4\"\n      :class=\"scrolled ? 'md:h-12 md:px-2' : ''\"\n    >\n      <div class=\"flex min-w-0 items-center gap-2\">\n        <a\n          :href=\"homeHref\"\n          :aria-label=\"homeLabel\"\n          class=\"shrink-0 rounded-md p-2 hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring\"\n          ><slot name=\"logo\"><HeaderLogo /></slot></a\n        ><span\n          aria-hidden=\"true\"\n          class=\"hidden h-6 w-px shrink-0 bg-border md:block\"\n        /><HeaderDesktopNav compact />\n      </div>\n      <div class=\"ml-auto flex shrink-0 items-center gap-2\">\n        <Button as-child size=\"sm\" variant=\"outline\" class=\"rounded-full\"\n          ><a :href=\"signInHref\">Sign In</a></Button\n        ><Button as-child size=\"sm\" class=\"rounded-full\"\n          ><a :href=\"signUpHref\">Get Started</a></Button\n        >\n      </div>\n      <HeaderMobileNav mega compact :sign-in-href=\"signInHref\" :sign-up-href=\"signUpHref\" />\n    </nav>\n  </header>\n</template>\n",
      "type": "registry:component",
      "target": "components/header/HeaderPill.vue"
    },
    {
      "path": "registry/header/HeaderLogo.vue",
      "content": "<!--\nMIT License\n\nCopyright (c) 2026 SikandarJODD\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n-->\n<template>\n  <svg\n    xmlns=\"http://www.w3.org/2000/svg\"\n    class=\"size-4\"\n    aria-hidden=\"true\"\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n    color=\"currentColor\"\n  >\n    <path\n      d=\"M12 21H12H12C16.2426 21 18.364 21 19.682 19.682C21 18.364 21 16.2426 21 12V12V12C21 7.75735 21 5.63604 19.682 4.31802C18.364 3 16.2426 3 12 3C7.75736 3 5.63604 3 4.31802 4.31802C3 5.63604 3 7.75736 3 12C3 16.2426 3 18.364 4.31802 19.682C5.63604 21 7.75735 21 12 21Z\"\n      stroke=\"currentColor\"\n      stroke-width=\"1.5\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    ></path>\n    <path\n      opacity=\"0.4\"\n      d=\"M15.7275 9.36502C16 9.8998 16 10.5999 16 12C16 13.4001 16 14.1002 15.7275 14.635C15.4878 15.1054 15.1054 15.4878 14.635 15.7275C14.1002 16 13.4001 16 12 16C10.5999 16 9.8998 16 9.36502 15.7275C8.89462 15.4878 8.51217 15.1054 8.27248 14.635C8 14.1002 8 13.4001 8 12C8 10.5999 8 9.8998 8.27248 9.36502C8.51217 8.89462 8.89462 8.51217 9.36502 8.27248C9.8998 8 10.5999 8 12 8C13.4001 8 14.1002 8 14.635 8.27248C15.1054 8.51217 15.4878 8.89462 15.7275 9.36502Z\"\n      stroke=\"currentColor\"\n      stroke-width=\"1.5\"\n      stroke-linecap=\"round\"\n      stroke-linejoin=\"round\"\n    ></path>\n  </svg>\n</template>\n",
      "type": "registry:component",
      "target": "components/header/HeaderLogo.vue"
    },
    {
      "path": "registry/header/HeaderMobileNav.vue",
      "content": "<!--\nMIT License\n\nCopyright (c) 2026 SikandarJODD\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n-->\n<script setup lang=\"ts\">\nimport { onMounted, ref, useTemplateRef } from \"vue\";\nimport { useEventListener } from \"@vueuse/core\";\nimport { Menu, X } from \"@lucide/vue\";\nimport {\n  DialogRoot,\n  DialogTrigger,\n  DialogPortal,\n  DialogOverlay,\n  DialogContent,\n  DialogTitle,\n  DialogDescription,\n  DialogClose,\n} from \"reka-ui\";\nimport { Button } from \"@/components/ui/button\";\nimport HeaderLinkItem from \"./HeaderLinkItem.vue\";\nimport { navLinks, productLinks, companyLinks, companyLinks2 } from \"./navigation\";\nconst open = ref(false);\nconst menuTrigger = useTemplateRef<InstanceType<typeof Button>>(\"menuTrigger\");\nonMounted(() => {\n  const view = menuTrigger.value?.$el.ownerDocument.defaultView as Window | undefined;\n  if (!view) return;\n  const desktop = view.matchMedia(\"(min-width: 768px)\");\n  useEventListener(desktop, \"change\", () => {\n    if (desktop.matches) open.value = false;\n  });\n});\nwithDefaults(\n  defineProps<{\n    mega?: boolean;\n    compact?: boolean;\n    home?: boolean;\n    signInLabel?: string;\n    signUpLabel?: string;\n    signInHref?: string;\n    signUpHref?: string;\n  }>(),\n  {\n    signInLabel: \"Sign In\",\n    signUpLabel: \"Get Started\",\n    signInHref: \"/login\",\n    signUpHref: \"/signup\",\n  },\n);\n</script>\n<template>\n  <DialogRoot v-model:open=\"open\">\n    <DialogTrigger as-child\n      ><Button\n        ref=\"menuTrigger\"\n        size=\"icon\"\n        variant=\"outline\"\n        class=\"md:hidden\"\n        aria-label=\"Open navigation menu\"\n        ><Menu class=\"size-4\" /></Button\n    ></DialogTrigger>\n    <DialogPortal>\n      <DialogOverlay class=\"fixed inset-0 z-50 bg-black/40 md:hidden\" />\n      <DialogContent\n        @keydown.esc.stop.prevent=\"open = false\"\n        class=\"fixed inset-x-0 top-0 z-50 max-h-dvh overflow-y-auto border-b bg-background p-4 text-foreground shadow-lg md:hidden\"\n        @click=\"\n          (event) => {\n            if ((event.target as HTMLElement).closest('a')) open = false;\n          }\n        \"\n      >\n        <div class=\"mb-5 flex items-center justify-between\">\n          <DialogTitle class=\"text-sm font-medium\">Navigation</DialogTitle\n          ><DialogClose as-child\n            ><Button size=\"icon\" variant=\"ghost\" aria-label=\"Close navigation menu\"\n              ><X class=\"size-4\" /></Button\n          ></DialogClose>\n        </div>\n        <DialogDescription class=\"sr-only\"\n          >Browse the site and access your account.</DialogDescription\n        >\n        <nav aria-label=\"Mobile navigation\" class=\"grid gap-2\">\n          <template v-if=\"mega\">\n            <p class=\"text-sm font-medium\">Product</p>\n            <HeaderLinkItem\n              v-for=\"item in compact ? productLinks.slice(0, 4) : productLinks\"\n              :key=\"item.label\"\n              :item=\"item\"\n              :compact=\"compact\"\n            />\n            <p class=\"mt-4 text-sm font-medium\">Company</p>\n            <HeaderLinkItem\n              v-for=\"item in [\n                ...companyLinks,\n                ...(compact ? companyLinks2.slice(0, 3) : companyLinks2),\n              ]\"\n              :key=\"item.label\"\n              :item=\"item\"\n              :compact=\"compact\"\n            />\n            <Button as-child variant=\"ghost\" class=\"justify-start\"><a href=\"/docs\">Docs</a></Button>\n          </template>\n          <template v-else\n            ><Button v-if=\"home\" as-child variant=\"ghost\" class=\"justify-start\"\n              ><a href=\"/\">Home</a></Button\n            ><Button\n              v-for=\"item in navLinks\"\n              :key=\"item.label\"\n              as-child\n              variant=\"ghost\"\n              class=\"justify-start\"\n              ><a :href=\"item.href\">{{ item.label }}</a></Button\n            ></template\n          >\n        </nav>\n        <div class=\"mt-8 grid gap-2\">\n          <Button as-child variant=\"outline\"\n            ><a :href=\"signInHref\">{{ signInLabel }}</a></Button\n          ><Button as-child\n            ><a :href=\"signUpHref\">{{ signUpLabel }}</a></Button\n          >\n        </div>\n      </DialogContent>\n    </DialogPortal>\n  </DialogRoot>\n</template>\n",
      "type": "registry:component",
      "target": "components/header/HeaderMobileNav.vue"
    },
    {
      "path": "registry/header/HeaderLinkItem.vue",
      "content": "<!--\nMIT License\n\nCopyright (c) 2026 SikandarJODD\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n-->\n<script setup lang=\"ts\">\nimport type { HeaderLink } from \"./navigation\";\ndefineProps<{ item: HeaderLink; compact?: boolean }>();\n</script>\n<template>\n  <a\n    :href=\"item.href\"\n    class=\"flex min-w-0 items-center gap-2 rounded-md p-2 hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n  >\n    <span\n      v-if=\"item.icon\"\n      class=\"flex size-9 shrink-0 items-center justify-center rounded-md border bg-card shadow-sm\"\n      :class=\"{ 'outline outline-offset-2 outline-border/60': compact }\"\n      ><component :is=\"item.icon\" class=\"size-4\" aria-hidden=\"true\"\n    /></span>\n    <span class=\"flex min-w-0 flex-col\"\n      ><span class=\"font-medium\" :class=\"compact ? 'text-xs' : 'text-sm'\">{{ item.label }}</span\n      ><span\n        v-if=\"item.description\"\n        class=\"text-muted-foreground\"\n        :class=\"compact ? 'line-clamp-1 text-[10px]' : 'text-xs'\"\n        >{{ item.description }}</span\n      ></span\n    >\n  </a>\n</template>\n",
      "type": "registry:component",
      "target": "components/header/HeaderLinkItem.vue"
    },
    {
      "path": "registry/header/navigation.ts",
      "content": "/* MIT License — Copyright (c) 2026 SikandarJODD. See HeaderSimple.vue for the full license. */\nimport {\n  FileTextIcon,\n  GlobeIcon,\n  LayersIcon,\n  PlugIcon,\n  ShieldIcon,\n  UserPlusIcon,\n  UsersIcon,\n  StarIcon,\n  HandshakeIcon,\n  CodeIcon,\n  RotateCcwIcon,\n  LeafIcon,\n  HandHelpingIcon,\n  ChartArea,\n} from \"@lucide/vue\";\n\nimport type { Component } from \"vue\";\nexport type HeaderLink = { label: string; href: string; description?: string; icon?: Component };\n\nconst productLinks: HeaderLink[] = [\n  {\n    label: \"Website Builder\",\n    href: \"/\",\n    description: \"Create responsive websites with ease\",\n    icon: GlobeIcon,\n  },\n  {\n    label: \"Cloud Platform\",\n    href: \"/\",\n    description: \"Deploy and scale apps in the cloud\",\n    icon: LayersIcon,\n  },\n  {\n    label: \"Team Collaboration\",\n    href: \"/\",\n    description: \"Tools to help your teams work better together\",\n    icon: UserPlusIcon,\n  },\n  {\n    label: \"Analytics\",\n    href: \"/\",\n    description: \"Track and analyze your website traffic\",\n    icon: ChartArea,\n  },\n  {\n    label: \"Integrations\",\n    href: \"/\",\n    description: \"Connect your apps and services\",\n    icon: PlugIcon,\n  },\n  {\n    label: \"API\",\n    href: \"/\",\n    description: \"Build custom integrations with our API\",\n    icon: CodeIcon,\n  },\n];\n\nconst companyLinks: HeaderLink[] = [\n  {\n    label: \"About Us\",\n    href: \"/\",\n    description: \"Learn more about our story and team\",\n    icon: UsersIcon,\n  },\n  {\n    label: \"Customer Stories\",\n    href: \"/\",\n    description: \"See how we've helped our clients succeed\",\n    icon: StarIcon,\n  },\n  {\n    label: \"Partnerships\",\n    href: \"/\",\n    icon: HandshakeIcon,\n    description: \"Collaborate with us for mutual growth\",\n  },\n];\n\nconst companyLinks2: HeaderLink[] = [\n  {\n    label: \"Terms of Service\",\n    href: \"/\",\n    icon: FileTextIcon,\n  },\n  {\n    label: \"Privacy Policy\",\n    href: \"/\",\n    icon: ShieldIcon,\n  },\n  {\n    label: \"Refund Policy\",\n    href: \"/\",\n    icon: RotateCcwIcon,\n  },\n  {\n    label: \"Blog\",\n    href: \"/\",\n    icon: LeafIcon,\n  },\n  {\n    label: \"Help Center\",\n    href: \"/\",\n    icon: HandHelpingIcon,\n  },\n];\n\nexport { productLinks, companyLinks, companyLinks2 };\n\nexport const navLinks: HeaderLink[] = [\n  { label: \"Features\", href: \"/\" },\n  { label: \"Pricing\", href: \"/\" },\n  { label: \"About\", href: \"/\" },\n];\n",
      "type": "registry:component",
      "target": "components/header/navigation.ts"
    },
    {
      "path": "registry/header/useHeaderScroll.ts",
      "content": "/*\nMIT License\n\nCopyright (c) 2026 SikandarJODD\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n*/\nimport { onMounted, ref, useTemplateRef } from \"vue\";\nimport { useEventListener } from \"@vueuse/core\";\n\nexport function useHeaderScroll(threshold = 10) {\n  const header = useTemplateRef<HTMLElement>(\"header\");\n  const scrolled = ref(false);\n  onMounted(() => {\n    // The preview lives in an iframe; listen to the window that owns the header.\n    const view = header.value?.ownerDocument.defaultView;\n    if (!view) return;\n    const update = () => {\n      scrolled.value = view.scrollY > threshold;\n    };\n    update();\n    useEventListener(view, \"scroll\", update, { passive: true });\n  });\n  return { scrolled };\n}\n",
      "type": "registry:component",
      "target": "components/header/useHeaderScroll.ts"
    },
    {
      "path": "registry/header/HeaderDesktopNav.vue",
      "content": "<!--\nMIT License\n\nCopyright (c) 2026 SikandarJODD\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n-->\n<script setup lang=\"ts\">\nimport { ChevronDown } from \"@lucide/vue\";\nimport {\n  NavigationMenuRoot,\n  NavigationMenuList,\n  NavigationMenuItem,\n  NavigationMenuTrigger,\n  NavigationMenuContent,\n  NavigationMenuLink,\n} from \"reka-ui\";\nimport HeaderLinkItem from \"./HeaderLinkItem.vue\";\nimport { productLinks, companyLinks, companyLinks2 } from \"./navigation\";\ndefineProps<{ compact?: boolean }>();\n</script>\n<template>\n  <NavigationMenuRoot class=\"relative hidden md:block\" aria-label=\"Main navigation\">\n    <NavigationMenuList class=\"flex list-none items-center gap-1\">\n      <NavigationMenuItem v-for=\"group in ['Product', 'Company']\" :key=\"group\">\n        <NavigationMenuTrigger\n          class=\"group flex h-9 items-center gap-1 rounded-md px-3 text-sm font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring data-[state=open]:bg-accent\"\n          >{{ group\n          }}<ChevronDown\n            class=\"size-3 transition-transform group-data-[state=open]:rotate-180 motion-reduce:transition-none\"\n            aria-hidden=\"true\"\n        /></NavigationMenuTrigger>\n        <NavigationMenuContent\n          class=\"absolute top-full left-0 z-50 mt-2 overflow-hidden rounded-lg border bg-muted p-1 text-popover-foreground shadow-lg dark:bg-background\"\n        >\n          <div\n            v-if=\"group === 'Product'\"\n            class=\"grid gap-2 rounded-lg border bg-popover p-2 shadow-sm\"\n            :class=\"compact ? 'w-64 grid-cols-1' : 'w-lg grid-cols-2'\"\n          >\n            <NavigationMenuLink\n              v-for=\"item in compact ? productLinks.slice(0, 4) : productLinks\"\n              :key=\"item.label\"\n              as-child\n              ><HeaderLinkItem :item=\"item\" :compact=\"compact\"\n            /></NavigationMenuLink>\n          </div>\n          <p v-if=\"group === 'Product'\" class=\"p-2 text-sm text-muted-foreground\">\n            Interested?\n            <NavigationMenuLink href=\"/\" class=\"font-medium text-foreground hover:underline\"\n              >Schedule a demo</NavigationMenuLink\n            >\n          </p>\n          <div v-else class=\"grid grid-cols-2 gap-2\" :class=\"compact ? 'w-sm' : 'w-lg'\">\n            <div class=\"space-y-2 rounded-lg border bg-popover p-2 shadow-sm\">\n              <NavigationMenuLink v-for=\"item in companyLinks\" :key=\"item.label\" as-child\n                ><HeaderLinkItem :item=\"item\" :compact=\"compact\"\n              /></NavigationMenuLink>\n            </div>\n            <div class=\"space-y-2 p-2\">\n              <NavigationMenuLink\n                v-for=\"item in compact ? companyLinks2.slice(0, 3) : companyLinks2\"\n                :key=\"item.label\"\n                as-child\n                ><a\n                  :href=\"item.href\"\n                  class=\"flex items-center gap-2 rounded-md p-1 text-sm hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n                  ><component :is=\"item.icon\" class=\"size-4 shrink-0\" aria-hidden=\"true\" />{{\n                    item.label\n                  }}</a\n                ></NavigationMenuLink\n              >\n            </div>\n          </div>\n        </NavigationMenuContent>\n      </NavigationMenuItem>\n      <NavigationMenuItem\n        ><NavigationMenuLink\n          href=\"/docs\"\n          class=\"rounded-md px-3 py-2 text-sm font-medium hover:bg-accent focus-visible:outline-2 focus-visible:outline-ring\"\n          >Docs</NavigationMenuLink\n        ></NavigationMenuItem\n      >\n    </NavigationMenuList>\n  </NavigationMenuRoot>\n</template>\n",
      "type": "registry:component",
      "target": "components/header/HeaderDesktopNav.vue"
    }
  ],
  "type": "registry:block"
}
