{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pricing-plan",
  "title": "Pricing Plan",
  "description": "A customizable pricing card with discounts, features and a call to action.",
  "dependencies": ["@lucide/vue", "@vueuse/core"],
  "registryDependencies": ["button", "badge"],
  "files": [
    {
      "path": "registry/pricing-plan/PricingPlan.vue",
      "content": "<script setup lang=\"ts\">\nimport { CheckIcon } from \"@lucide/vue\";\nimport { createReusableTemplate } from \"@vueuse/core\";\nimport PricingPlanPrice from \"./PricingPlanPrice.vue\";\nimport { computed } from \"vue\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { cn } from \"@/lib/utils\";\nimport type { PricingPlanProps } from \"./index\";\n\ndefineOptions({ inheritAttrs: false });\n\nconst props = withDefaults(defineProps<PricingPlanProps>(), {\n  as: \"div\",\n  orientation: \"vertical\",\n  variant: \"outline\",\n});\nconst badgeProps = computed(() =>\n  typeof props.badge === \"string\" ? { label: props.badge } : props.badge,\n);\nconst [DefinePrice, PlanPrice] = createReusableTemplate();\n</script>\n\n<template>\n  <DefinePrice>\n    <PricingPlanPrice\n      :price=\"price\"\n      :discount=\"discount\"\n      :billing-period=\"billingPeriod\"\n      :billing-cycle=\"billingCycle\"\n    >\n      <template\n        v-for=\"name in (['price', 'discount', 'billing'] as const).filter((name) => $slots[name])\"\n        :key=\"name\"\n        #[name]\n      >\n        <slot :name=\"name\" />\n      </template>\n    </PricingPlanPrice>\n  </DefinePrice>\n  <component\n    :is=\"typeof as === 'string' ? as : (as.root ?? 'div')\"\n    v-bind=\"$attrs\"\n    data-slot=\"pricing-plan\"\n    :class=\"\n      cn(\n        'relative grid min-w-0 gap-6 rounded-lg p-6 text-foreground lg:p-8',\n        orientation === 'horizontal' && 'lg:grid-cols-3',\n        variant === 'outline' && 'border bg-background',\n        variant === 'soft' && 'bg-muted/50',\n        variant === 'subtle' && 'border bg-muted/50',\n        variant === 'solid' &&\n          'bg-foreground text-background [&_.text-muted-foreground]:text-background/70',\n        highlight && 'ring-2 ring-inset ring-primary',\n        scale && 'lg:z-10 lg:scale-110',\n        props.class,\n      )\n    \"\n  >\n    <div\n      :class=\"\n        cn(\n          'flex min-w-0 flex-col',\n          orientation === 'horizontal' && 'lg:col-span-2 lg:justify-center lg:border-e lg:pe-6',\n        )\n      \"\n    >\n      <slot name=\"body\">\n        <div\n          v-if=\"\n            title ||\n            description ||\n            badge ||\n            $slots.header ||\n            $slots.title ||\n            $slots.description ||\n            $slots.badge\n          \"\n        >\n          <slot name=\"header\">\n            <div class=\"flex flex-wrap items-center gap-3\">\n              <component\n                :is=\"typeof as === 'object' ? (as.title ?? 'div') : 'div'\"\n                v-if=\"title || $slots.title\"\n                data-slot=\"pricing-plan-title\"\n                class=\"text-2xl font-semibold tracking-tight sm:text-3xl\"\n                ><slot name=\"title\">{{ title }}</slot></component\n              >\n              <slot name=\"badge\"\n                ><Badge v-if=\"badgeProps\" :variant=\"badgeProps.variant ?? 'secondary'\">{{\n                  badgeProps.label\n                }}</Badge></slot\n              >\n            </div>\n            <p\n              v-if=\"description || $slots.description\"\n              data-slot=\"pricing-plan-description\"\n              class=\"mt-2 text-base text-muted-foreground\"\n            >\n              <slot name=\"description\">{{ description }}</slot>\n            </p>\n          </slot>\n        </div>\n        <div v-if=\"orientation === 'vertical'\" class=\"mt-6\">\n          <PlanPrice />\n        </div>\n        <div v-if=\"features?.length || $slots.features\" class=\"mt-6\">\n          <slot name=\"features\">\n            <ul :class=\"cn('grid gap-3', orientation === 'horizontal' && 'lg:mt-6 lg:grid-cols-2')\">\n              <li\n                v-for=\"(feature, index) in features\"\n                :key=\"index\"\n                class=\"flex min-w-0 items-start gap-2 text-sm text-muted-foreground\"\n              >\n                <component\n                  :is=\"typeof feature === 'string' ? CheckIcon : (feature.icon ?? CheckIcon)\"\n                  class=\"size-5 shrink-0 text-primary\"\n                  aria-hidden=\"true\"\n                />\n                <span>{{ typeof feature === \"string\" ? feature : feature.title }}</span>\n              </li>\n            </ul>\n          </slot>\n        </div>\n      </slot>\n    </div>\n    <div\n      :class=\"\n        cn(\n          'flex min-w-0 flex-col justify-end gap-6',\n          orientation === 'horizontal' &&\n            'border-t pt-6 lg:items-center lg:justify-center lg:border-0 lg:pt-0',\n        )\n      \"\n    >\n      <slot name=\"footer\">\n        <p v-if=\"tagline || $slots.tagline\" class=\"text-base font-semibold\">\n          <slot name=\"tagline\">{{ tagline }}</slot>\n        </p>\n        <PlanPrice v-if=\"orientation === 'horizontal'\" />\n        <slot name=\"button\">\n          <Button\n            v-if=\"button\"\n            v-bind=\"button\"\n            :as=\"button.href && !button.disabled ? 'a' : 'button'\"\n            :href=\"button.disabled ? undefined : button.href\"\n            :type=\"button.href && !button.disabled ? undefined : 'button'\"\n            :size=\"button.size ?? 'lg'\"\n            class=\"w-full\"\n            >{{ button.label }}</Button\n          >\n        </slot>\n        <p v-if=\"terms || $slots.terms\" class=\"text-center text-xs leading-5 text-muted-foreground\">\n          <slot name=\"terms\">{{ terms }}</slot>\n        </p>\n      </slot>\n    </div>\n  </component>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/pricing-plan/PricingPlanPrice.vue",
      "content": "<script setup lang=\"ts\">\nimport type { PricingPlanProps } from \"./index\";\n\ndefineProps<Pick<PricingPlanProps, \"price\" | \"discount\" | \"billingPeriod\" | \"billingCycle\">>();\n</script>\n\n<template>\n  <div\n    v-if=\"price || discount || $slots.price || $slots.discount || $slots.billing\"\n    class=\"flex flex-wrap items-center gap-2\"\n  >\n    <del v-if=\"discount\" class=\"text-xl text-muted-foreground\"\n      ><slot name=\"discount\">{{ price }}</slot></del\n    >\n    <span class=\"text-3xl font-semibold tracking-tight sm:text-4xl\"\n      ><slot name=\"price\">{{ discount ?? price }}</slot></span\n    >\n    <div\n      v-if=\"billingPeriod || billingCycle || $slots.billing\"\n      class=\"min-w-0 text-xs text-muted-foreground\"\n    >\n      <slot name=\"billing\"\n        ><p v-if=\"billingPeriod\" class=\"font-medium\">{{ billingPeriod }}</p>\n        <p v-if=\"billingCycle\">{{ billingCycle }}</p></slot\n      >\n    </div>\n  </div>\n</template>\n",
      "type": "registry:component"
    },
    {
      "path": "registry/pricing-plan/index.ts",
      "content": "import type { Component, HTMLAttributes } from \"vue\";\nimport type { ButtonVariants } from \"@/components/ui/button\";\nimport type { BadgeVariants } from \"@/components/ui/badge\";\n\nexport { default as PricingPlan } from \"./PricingPlan.vue\";\n\nexport interface PricingPlanFeature {\n  title: string;\n  icon?: Component;\n}\nexport interface PricingPlanButton {\n  label: string;\n  variant?: ButtonVariants[\"variant\"];\n  size?: ButtonVariants[\"size\"];\n  disabled?: boolean;\n  href?: string;\n  target?: string;\n  rel?: string;\n  onClick?: (event: MouseEvent) => void;\n}\nexport interface PricingPlanBadge {\n  label: string;\n  variant?: BadgeVariants[\"variant\"];\n}\nexport interface PricingPlanProps {\n  as?: string | { root?: string; title?: string };\n  title?: string;\n  description?: string;\n  badge?: string | PricingPlanBadge;\n  price?: string;\n  discount?: string;\n  billingCycle?: string;\n  billingPeriod?: string;\n  features?: (string | PricingPlanFeature)[];\n  button?: PricingPlanButton;\n  tagline?: string;\n  terms?: string;\n  orientation?: \"vertical\" | \"horizontal\";\n  variant?: \"outline\" | \"solid\" | \"soft\" | \"subtle\";\n  highlight?: boolean;\n  scale?: boolean;\n  class?: HTMLAttributes[\"class\"];\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}
