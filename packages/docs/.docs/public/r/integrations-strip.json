{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "integrations-strip",
  "title": "Strip Integrations",
  "description": "A compact integration strip with lightweight cards and a link-out action.",
  "dependencies": ["@lucide/vue"],
