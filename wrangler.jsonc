{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prop-show-kit",
  "main": "workers/site.mjs",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "packages/docs/.output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true,
  },
  "previews": {},
}
