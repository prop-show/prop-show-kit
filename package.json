{
  "name": "prop-show-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run docs#dev",
    "build": "vp run docs#build",
    "generate": "vp run docs#build",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "ready": "vp check && vp run ui#test && vp test run --passWithNoTests && vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "undocs-nightly@0.10.1-20260828-133553-e5fe415": "patches/undocs-nightly.patch"
    }
  }
}
